APP_NAME="Gestionale Multi-Loggia"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Solo se la directory web cPanel è separata dalla public originale.
APP_PUBLIC_PATH=
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# Configurare SMTP prima di abilitare notifiche o OTP; nessun canale pronto.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Servizio amministrativo"
VITE_APP_NAME="${APP_NAME}"

# Nessun successo simulato: fake consentito esclusivamente nei test.
IDENTITY_DELIVERY_DRIVER=configured
# Opzionale: segreto casuale >=32 caratteri; se vuoto, derivato da APP_KEY.
OTP_SECRET=
MAIL_REQUIRE_TLS=true
SMS_DRIVER=disabled
SMS_ENDPOINT=
SMS_TOKEN=
SMS_SENDER=

# Fase 8: nessun invio periodico senza abilitazione esplicita globale e locale.
COMMUNICATIONS_ENABLED=false
COMMUNICATIONS_OVERDUE_INTERVAL_DAYS=7
BACKUP_PUBLIC_KEY_FILE=
BACKUP_DIRECTORY=
MYSQLDUMP_BINARY=mysqldump
BACKUP_MAX_AGE_HOURS=26
QUEUE_MAX_AGE_MINUTES=15
# Politiche approvate dal titolare: zero disabilita la cancellazione.
PRIVACY_POLICY_REFERENCE=
PRIVACY_TECHNICAL_RETENTION_DAYS=0
PRIVACY_COMMUNICATION_RETENTION_DAYS=0
PRIVACY_PERSON_RETENTION_DAYS=0
